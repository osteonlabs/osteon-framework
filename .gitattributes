# .gitattributes - Enforce consistent LF line endings and binary attributes
* text=auto eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.tsv text eol=lf
*.txt text eol=lf
*.cff text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.tar binary
*.gz binary
